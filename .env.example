VITE_SUPABASE_PROJECT_ID=tu_project_id_supabase
VITE_SUPABASE_PUBLISHABLE_KEY=tu_publishable_key_supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Opcional: define esta clave solo si quieres activar Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# GOOGLE MAPS (server-side solamente — NO va en variables VITE_*)
# Configurar como Supabase secret, no aquí:
#   supabase secrets set GOOGLE_MAPS_API_KEY=AIza...
# APIs requeridas: Places API (New), Routes API, Geocoding API
# Ver NOTAS_GOOGLE_MAPS.md para instrucciones completas.
# ──────────────────────────────────────────────────────────────────────────────
