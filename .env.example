VITE_SUPABASE_PROJECT_ID=tu_project_id_supabase
VITE_SUPABASE_PUBLISHABLE_KEY=tu_publishable_key_supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Opcional: define esta clave solo si quieres activar Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# GOOGLE MAPS — dos keys separadas, cada una restringida a su propio uso
# ──────────────────────────────────────────────────────────────────────────────
# 1) Server-side (Edge Functions vía maps-proxy/tollroutes-proxy) — NO va en
#    variables VITE_* ni en este archivo. Se configura como Supabase secret:
#      supabase secrets set GOOGLE_MAPS_API_KEY=AIza...
#    Sin restricción de dominio/IP (las Edge Functions no mandan Referer).
#    APIs: Places API (New), Routes API, Geocoding API, Maps Static API.
#
# 2) Cliente (mapa interactivo en el navegador, Trip Calculator) — sí va acá,
#    se expone en el bundle del frontend. Su protección es la restricción por
#    dominio (HTTP referrers) configurada en Google Cloud Console, no el secreto.
#    API: Maps JavaScript API únicamente.
VITE_GOOGLE_MAPS_JS_API_KEY=tu_key_restringida_por_dominio
